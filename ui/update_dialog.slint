// 更新对话框组件。

import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme, UpdateDialogData, ThemedButton } from "common.slint";

export component UpdateDialog inherits Dialog {
    in-out property <UpdateDialogData> data;
    in property <Theme> theme;

    callback update(string);
    callback skip-version(string, string);
    callback ignore-program(string);
    callback dismissed();

    title: "Update available: " + data.program-name;
    min-width: 480px;
    min-height: 380px;
    background: theme.background;

    VerticalBox {
        padding: 20px;
        spacing: 14px;

        // 标题 + 发布日期
        HorizontalBox {
            spacing: 10px;
            alignment: space-between;

            Text {
                text: "Update available: " + data.program-name;
                color: theme.text;
                font-size: 16px;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }

            Text {
                text: data.published-at;
                color: theme.text-muted;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        // 版本号对比
        HorizontalBox {
            spacing: 12px;
            alignment: center;

            Text {
                text: data.current-version != "" ? data.current-version : "-";
                color: theme.text-muted;
                font-size: 22px;
                font-family: "Consolas";
                font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                text: "->";
                color: theme.accent;
                font-size: 22px;
                vertical-alignment: center;
            }

            Text {
                text: data.latest-version;
                color: theme.success;
                font-size: 22px;
                font-family: "Consolas";
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        // 发布说明：宽度/高度均受约束，随弹窗尺寸自适应
        Rectangle {
            preferred-width: 480px;
            min-width: 380px;
            max-width: 560px;
            preferred-height: 200px;
            min-height: 120px;
            max-height: 320px;
            background: theme.surface;
            border-radius: 6px;
            border-width: 1px;
            border-color: theme.border;

            VerticalLayout {
                padding: 12px;

                Text {
                    text: data.release-notes != "" ? data.release-notes : "No release notes.";
                    color: theme.text;
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
            }
        }

        // 操作按钮
        HorizontalBox {
            spacing: 8px;
            alignment: end;

            ThemedButton {
                theme: root.theme;
                text: data.ignored ? "Ignored" : "Ignore";
                bg: theme.surface-alt;
                enabled: !data.ignored;
                preferred-width: 90px;
                clicked => { root.ignore-program(data.program-id); }
            }

            ThemedButton {
                theme: root.theme;
                text: "Skip this version";
                bg: theme.surface-alt;
                preferred-width: 130px;
                clicked => {
                    root.skip-version(data.program-id, data.latest-version);
                }
            }

            ThemedButton {
                theme: root.theme;
                text: "Update";
                bold: true;
                bg: theme.accent;
                hover-bg: theme.accent-hover;
                text-color: white;
                preferred-width: 90px;
                clicked => { root.update(data.program-id); }
            }
        }

        // 关闭链接
        Rectangle {
            preferred-height: 24px;
            min-height: 24px;

            Text {
                text: "Close";
                color: theme.text-muted;
                font-size: 11px;
                horizontal-alignment: end;
                vertical-alignment: center;
                width: parent.width;
            }
            TouchArea {
                clicked => { root.dismissed(); }
                mouse-cursor: pointer;
            }
        }
    }
}
