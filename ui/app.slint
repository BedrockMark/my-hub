// my-hub 主窗口 - 顶层 UI。

import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme, ProgramInfo, UpdateDialogData, ThemedButton } from "common.slint";
import { UpdateDialog } from "update_dialog.slint";
import { SettingsPanel } from "settings.slint";

export { Theme, ProgramInfo, UpdateDialogData }
export { UpdateDialog }
export { SettingsPanel }

// 程序列表行组件
component ProgramRowItem inherits Rectangle {
    in property <ProgramInfo> program;
    in property <Theme> theme;

    callback open-program(string);
    callback request-update(string);

    min-height: 52px;
    preferred-height: 56px;
    border-radius: 6px;
    background: theme.surface;
    border-width: 1px;
    border-color: theme.border;

    HorizontalBox {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;

        // 左侧：状态条 + 名称/描述（占据剩余宽度，窄窗口时文本省略）
        HorizontalBox {
            horizontal-stretch: 1;
            preferred-width: 0px;
            spacing: 10px;
            alignment: start;

            Rectangle {
                preferred-width: 4px;
                min-width: 4px;
                preferred-height: 32px;
                border-radius: 2px;
                background: program.has-update ? theme.warning : theme.success;
            }

            VerticalBox {
                spacing: 2px;

                HorizontalBox {
                    spacing: 6px;

                    Text {
                        text: program.name;
                        color: theme.text;
                        font-size: 13px;
                        font-weight: 700;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    if program.is-self: Rectangle {
                        preferred-width: 50px;
                        min-width: 44px;
                        preferred-height: 18px;
                        border-radius: 9px;
                        background: theme.accent;
                        Text {
                            text: "self";
                            color: white;
                            font-size: 10px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                        }
                    }
                }

                Text {
                    text: program.owner + "/" + program.repo + "  -  " + program.description;
                    color: theme.text-muted;
                    font-size: 11px;
                    overflow: elide;
                }
            }
        }

        // 右侧：版本信息 + 操作按钮
        HorizontalBox {
            spacing: 14px;
            alignment: end;

            VerticalBox {
                spacing: 2px;
                alignment: center;

                Text {
                    text: "Current";
                    color: theme.text-muted;
                    font-size: 10px;
                    font-weight: 600;
                    horizontal-alignment: right;
                }
                Text {
                    text: program.current-version != "" ? program.current-version : "-";
                    color: theme.text;
                    font-size: 13px;
                    font-family: "Consolas";
                    font-weight: 600;
                    overflow: elide;
                    horizontal-alignment: right;
                }
            }

            VerticalBox {
                spacing: 2px;
                alignment: center;

                Text {
                    text: "Latest";
                    color: theme.text-muted;
                    font-size: 10px;
                    font-weight: 600;
                    horizontal-alignment: right;
                }
                Text {
                    text: program.latest-version != "" ? program.latest-version : "-";
                    color: program.has-update ? theme.success : theme.text;
                    font-size: 13px;
                    font-family: "Consolas";
                    font-weight: 600;
                    overflow: elide;
                    horizontal-alignment: right;
                }
            }

            ThemedButton {
                theme: root.theme;
                text: program.has-update ? "Update" : program.ignored ? "Ignored" : "Latest";
                bold: true;
                bg: program.has-update ? theme.accent : theme.surface-alt;
                hover-bg: program.has-update ? theme.accent-hover : theme.surface;
                text-color: program.has-update ? white : theme.text-muted;
                enabled: !program.ignored;
                preferred-width: 90px;
                min-width: 84px;
                clicked => {
                    if program.has-update {
                        root.request-update(program.id);
                    } else {
                        root.open-program(program.id);
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    in property <Theme> theme: {
        background: #1a1a1a,
        surface: #242424,
        surface-alt: #2c2c2c,
        border: #333333,
        text: #e8e8e8,
        text-muted: #909090,
        accent: #4a9eff,
        accent-hover: #6ab2ff,
        success: #4ade80,
        warning: #fbbf24,
        danger: #ef4444,
    };
    in-out property <[ProgramInfo]> programs: [];
    in property <string> last-check: "-";
    in property <bool> is-checking: false;
    in property <bool> settings-visible: false;
    in property <UpdateDialogData> dialog-data;

    in-out property <bool> check-on-startup: true;
    in-out property <bool> start-with-windows: false;
    in-out property <string> download-dir: "";
    in-out property <string> github-pat: "";
    in-out property <string> theme-mode: "Dark";
    in-out property <string> accent-color: "#4a9eff";
    in-out property <string> background-color: "#1a1a1a";
    in-out property <string> text-color: "#e8e8e8";

    callback check-now();
    callback open-settings();
    callback close-settings();
    callback save-general(bool, bool, string, string);
    callback save-theme(string, string, string, string);
    callback request-update(string);
    callback skip-version(string, string);
    callback ignore-program(string);
    callback open-program(string);
    callback close-dialog();

    title: "my-hub - Manage your my-family programs";
    preferred-width: 980px;
    preferred-height: 640px;
    min-width: 780px;
    min-height: 480px;
    background: theme.background;
    default-font-family: "Segoe UI";

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        // 头部
        HorizontalBox {
            spacing: 12px;
            alignment: space-between;

            HorizontalBox {
                spacing: 12px;
                alignment: start;

                Text {
                    text: "my-hub";
                    color: theme.text;
                    font-size: 22px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Text {
                    text: "Manage your my-family programs";
                    color: theme.text-muted;
                    font-size: 12px;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }

            HorizontalBox {
                spacing: 8px;
                alignment: end;

                ThemedButton {
                    theme: root.theme;
                    text: "Settings";
                    preferred-width: 90px;
                    clicked => { root.open-settings(); }
                }

                ThemedButton {
                    theme: root.theme;
                    text: root.is-checking ? "Checking..." : "Check now";
                    bold: true;
                    bg: theme.accent;
                    hover-bg: theme.accent-hover;
                    text-color: white;
                    enabled: !root.is-checking;
                    preferred-width: 110px;
                    clicked => { root.check-now(); }
                }
            }
        }

        // 程序列表：stretch 占据剩余垂直空间，随窗口自适应
        Rectangle {
            vertical-stretch: 1;
            preferred-height: 120px;
            min-height: 80px;
            background: theme.surface-alt;
            border-radius: 8px;
            border-width: 1px;
            border-color: theme.border;

            VerticalLayout {
                padding: 8px;
                spacing: 6px;

                for p in root.programs: ProgramRowItem {
                    program: p;
                    theme: root.theme;
                    open-program(id) => { root.open-program(id); }
                    request-update(id) => { root.request-update(id); }
                }

                if root.programs.length == 0: Text {
                    text: "No programs yet. Edit assets/default-manifest.toml to add my-family programs.";
                    color: theme.text-muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                    preferred-height: 60px;
                }
            }
        }

        // 状态栏
        HorizontalBox {
            spacing: 12px;
            alignment: space-between;

            Text {
                text: "Last check: " + root.last-check;
                color: theme.text-muted;
                font-size: 11px;
                vertical-alignment: center;
            }

            Text {
                text: root.programs.length + " programs";
                color: theme.text-muted;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
    }

    // --- 设置弹窗 ---
    if root.settings-visible: SettingsPanel {
        theme: root.theme;
        check-on-startup <=> root.check-on-startup;
        start-with-windows <=> root.start-with-windows;
        download-dir <=> root.download-dir;
        github-pat <=> root.github-pat;
        theme-mode <=> root.theme-mode;
        accent-color <=> root.accent-color;
        background-color <=> root.background-color;
        text-color <=> root.text-color;
        save-general(b1, b2, s1, s2) => { root.save-general(b1, b2, s1, s2); }
        save-theme(s1, s2, s3, s4) => { root.save-theme(s1, s2, s3, s4); }
        dismissed => { root.close-settings(); }
    }

    // --- 更新弹窗 ---
    if dialog-data.program-id != "": UpdateDialog {
        data: root.dialog-data;
        theme: root.theme;
        update(id) => { root.request-update(id); }
        skip-version(id, v) => { root.skip-version(id, v); }
        ignore-program(id) => { root.ignore-program(id); }
        dismissed => { root.close-dialog(); }
    }
}
