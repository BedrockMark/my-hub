// 设置面板组件。

import { VerticalBox, HorizontalBox, LineEdit, CheckBox } from "std-widgets.slint";
import { Theme, SectionHeader, ThemeModeSelector, ColorField, ThemedButton } from "common.slint";

export component SettingsPanel inherits Dialog {
    in property <Theme> theme;
    in-out property <bool> check-on-startup: true;
    in-out property <bool> start-with-windows: false;
    in-out property <bool> move-to-exe-dir: false;
    in-out property <string> download-dir: "";
    in-out property <string> github-pat: "";
    in-out property <string> theme-mode: "Dark";
    in-out property <string> accent-color: "#4a9eff";
    in-out property <string> background-color: "#1a1a1a";
    in-out property <string> text-color: "#e8e8e8";

    callback save-general(bool, bool, bool, string, string);
    callback save-theme(string, string, string, string);
    callback dismissed();

    title: "my-hub Settings";
    min-width: 640px;
    min-height: 540px;
    background: theme.background;

    VerticalBox {
        padding: 20px;
        spacing: 14px;

        Text {
            text: "Settings";
            color: theme.text;
            font-size: 18px;
            font-weight: 700;
        }

        // General 小节
        SectionHeader { theme: root.theme; section-title: "General"; }

        CheckBox {
            text: "Check for updates on startup";
            checked: root.check-on-startup;
            toggled => { root.check-on-startup = self.checked; }
        }

        CheckBox {
            text: "Start my-hub with Windows";
            checked: root.start-with-windows;
            toggled => { root.start-with-windows = self.checked; }
        }

        SectionHeader { theme: root.theme; section-title: "Download directory"; }

        LineEdit {
            text: root.download-dir;
            placeholder-text: "%LOCALAPPDATA%\\my-hub\\downloads";
            edited(s) => { root.download-dir = s; }
            preferred-height: 32px;
            // 勾选“移动到 exe 目录”时下载位置固定，禁止编辑
            enabled: !root.move-to-exe-dir;
        }

        CheckBox {
            text: "Move downloaded updates next to my-hub exe (into an 'installed' folder)";
            checked: root.move-to-exe-dir;
            toggled => { root.move-to-exe-dir = self.checked; }
        }

        SectionHeader { theme: root.theme; section-title: "GitHub PAT (optional)"; }

        LineEdit {
            text: root.github-pat;
            placeholder-text: "ghp_...";
            edited(s) => { root.github-pat = s; }
            preferred-height: 32px;
        }

        // Theme 小节
        SectionHeader { theme: root.theme; section-title: "Theme"; }

        ThemeModeSelector {
            theme: root.theme;
            mode <=> root.theme-mode;
        }

        HorizontalBox {
            spacing: 8px;

            ColorField {
                theme: root.theme;
                label: "Accent";
                placeholder: "#4a9eff";
                value <=> root.accent-color;
            }

            ColorField {
                theme: root.theme;
                label: "Background";
                placeholder: "#1a1a1a";
                value <=> root.background-color;
            }

            ColorField {
                theme: root.theme;
                label: "Text";
                placeholder: "#e8e8e8";
                value <=> root.text-color;
            }
        }

        // 底部按钮
        HorizontalBox {
            spacing: 8px;
            alignment: end;

            ThemedButton {
                theme: root.theme;
                text: "Close";
                preferred-width: 90px;
                clicked => { root.dismissed(); }
            }

            ThemedButton {
                theme: root.theme;
                text: "Save";
                bold: true;
                bg: theme.accent;
                hover-bg: theme.accent-hover;
                text-color: white;
                preferred-width: 90px;
                clicked => {
                    root.save-general(
                        root.check-on-startup,
                        root.start-with-windows,
                        root.move-to-exe-dir,
                        root.download-dir,
                        root.github-pat
                    );
                    root.save-theme(
                        root.theme-mode,
                        root.accent-color,
                        root.background-color,
                        root.text-color
                    );
                }
            }
        }
    }
}
